# Copy to .env. SECRETS ONLY plus infrastructure -- product settings live in
# Postgres, per org, and are edited in the app. Provider-prefixed names
# throughout so a new provider slots in without renaming anything.

# --- Database ---
CRM_DB_HOST=localhost
CRM_DB_PORT=5432
CRM_DB_NAME=crm
# The app role must never be a superuser and must never have BYPASSRLS --
# either silently defeats every policy in the schema. /health reports this.
CRM_DB_USER=crm_app
CRM_DB_PASSWORD=devpassword123

# --- Server ---
CRM_HOST=127.0.0.1
CRM_PORT=8500
CRM_PUBLIC_BASE_URL=http://localhost:8500

# Set false only for local plain-HTTP development.
CRM_SESSION_COOKIE_SECURE=true

# Close this once the first administrator exists. It is refused automatically
# after setup; this is belt-and-braces for a public deployment.
CRM_ALLOW_FIRST_RUN_SETUP=true

# --- Live-action gates -------------------------------------------------------
# Every outbound/destructive path is off until explicitly enabled.
CRM_CALENDAR_WRITE_ENABLED=false
CRM_SEND_MAIL_ENABLED=false
CRM_CONTACT_WRITEBACK_ENABLED=false
CRM_MESSAGING_SEND_ENABLED=false

# --- Secrets (M2+) -----------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDECODE_KEY=
MICROSOFT_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
SIGNAL_CLI_NUMBER=
